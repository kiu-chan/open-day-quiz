{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "checkJs": false,
    "paths": {
      "@/*": ["./src/*"],
      "@features/*": ["./src/features/*"],
      "@common/*": ["./src/common/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
