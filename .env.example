# Copy to `.env` only if you want to set things by hand — nothing here is
# required to run the app.

# The admin password, hashed with scrypt as `scrypt:<salt>:<key>`.
# You do not write this yourself: leave it out, open #/admin, and the first-run
# screen asks for a password and writes the line into `.env` for you.
# Forgotten the password? Delete the line and restart the server.
# ADMIN_PASSWORD_HASH=scrypt:...:...

# The port the game server listens on (default 3000).
# PORT=3000
